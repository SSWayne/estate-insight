{
  "name": "estate-insight",
  "version": "0.1.0",
  "private": true,
  "description": "Estate Insight — 台北市與新北市購屋分析系統（原生 HTML / CSS / JavaScript）",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "vendor": "node scripts/copy-vendor.mjs",
    "postinstall": "node scripts/copy-vendor.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.14.0",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "chart.js": "^4.4.9",
    "lucide": "^0.511.0"
  }
}
